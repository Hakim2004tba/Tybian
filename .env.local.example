# Bunny Stream — the ONLY video provider in this project (see
# lib/video/VideoService.ts). All of these are server-only secrets;
# none may ever be referenced from a Client Component.

BUNNY_STREAM_LIBRARY_ID=731741
BUNNY_STREAM_API_KEY=f8f9f415-f062-4d53-97f4f416fa55-1eaa-4d73   

# Separate from the API key — Bunny Stream's "Token Authentication Key"
# for this library, used only to sign short-lived playback URLs.
BUNNY_STREAM_TOKEN_AUTH_KEY=c4d80e7c-ae9c-4418-8592-6e4033fc91ad
# The pull zone hostname Bunny assigns this library, used to build
# deterministic thumbnail URLs (e.g. vz-xxxxx.b-cdn.net).
BUNNY_STREAM_PULL_ZONE_HOSTNAME=vz-c2fbf3c4-e5d.b-cdn.net
# Shared secret appended as ?secret=... to the webhook URL you configure
# in the Bunny dashboard — Bunny does not HMAC-sign Stream webhooks, so
# this is the practical verification mechanism (see the webhook route's
# doc comment for details).
BUNNY_STREAM_WEBHOOK_SECRET=83jdh83yd73g653gd
NODE_OPTIONS=--dns-result-order=ipv4first

# Payment provider — deliberately unconfigured (see
# lib/payment/providers/unconfigured.ts). No real credentials or API
# details are assumed anywhere in this codebase; the variables below are
# a placeholder shape for whenever official Chargily Pay (or another
# provider's) documentation and credentials are supplied.
# CHARGILY_API_KEY=
# CHARGILY_WEBHOOK_SECRET=

# Shared secret for the scheduled analytics-refresh endpoint
# (app/api/cron/refresh-analytics) — wire this up to Vercel Cron or any
# external scheduler as the `x-cron-secret` header.
ANALYTICS_CRON_SECRET=choose-another-long-random-string
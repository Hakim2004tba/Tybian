# Supabase project credentials — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the client, NEVER add a NEXT_PUBLIC_ prefix.
# Used only by lib/supabase/admin.ts (webhooks, admin-privileged backend ops).
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=

# Bunny Stream — the ONLY video provider in this project (see
# lib/video/VideoService.ts). All of these are server-only secrets;
# none may ever be referenced from a Client Component.


# Separate from the API key — Bunny Stream's "Token Authentication Key"
# for this library, used only to sign short-lived playback URLs.
# The pull zone hostname Bunny assigns this library, used to build
# deterministic thumbnail URLs (e.g. vz-xxxxx.b-cdn.net).
# Shared secret appended as ?secret=... to the webhook URL you configure
# in the Bunny dashboard — Bunny does not HMAC-sign Stream webhooks, so
# this is the practical verification mechanism (see the webhook route's
# doc comment for details).
NODE_OPTIONS=--dns-result-order=ipv4first

# Payment provider — deliberately unconfigured (see
# lib/payment/providers/unconfigured.ts). No real credentials or API
# details are assumed anywhere in this codebase; the variables below are
# a placeholder shape for whenever official Chargily Pay (or another
# provider's) documentation and credentials are supplied.

# Shared secret for the scheduled analytics-refresh endpoint
# (app/api/cron/refresh-analytics) — wire this up to Vercel Cron or any
# external scheduler as the `x-cron-secret` header.
ANALYTICS_CRON_SECRET=

# AI study assistant (Google Gemini free tier). Server-only — never expose with a
# NEXT_PUBLIC_ prefix: this key bills your account per token, and a
# client-visible key can be used by anyone who opens devtools.
# Get a free key at aistudio.google.com/apikey. Leave it unset to disable the
# assistant cleanly — the widget then reports that it is not configured
# instead of erroring.
GEMINI_API_KEY=
# Model id. The docs list more than one current flash model, so this is
# overridable without a rebuild if the default is rejected.
GEMINI_MODEL=gemini-3.8-flash

# Chargily Pay v2 — the payment gateway.
# BASE URL DECIDES TEST VS LIVE. Set it deliberately; do not rely on the
# key prefix, because "we thought we were in test mode" is how real cards
# get charged during a demo.
#   test: https://pay.chargily.net/test/api/v2
#   live: https://pay.chargily.net/api/v2
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2
# Secret key from the Chargily dashboard (test_sk_... or live_sk_...).
# Server-only — it both charges cards and verifies webhook signatures.
CHARGILY_API_KEY=


DB_NAME=
DB_USER=
DB_PASSWORD=

# Remote access from this Mac (cPanel > Remote Database Access must allow this IP).
# On the SERVER this must be localhost instead.
DB_HOST=127.0.0.1
DB_PORT=3306

# Google sign-in (optional — the button hides itself when unset).
# Create an "OAuth client ID" of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this exact
# redirect URI, with no trailing slash:
#   https://tybianacademy.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The address students see, and reply to.
#
# IMPORTANT: most SMTP servers — cPanel's included — refuse to send a
# message whose From: address is not the mailbox that authenticated, or
# let it through and watch SPF/DKIM fail so it lands in spam. So make
# contact@ the real mailbox and authenticate AS it:
#
#   SMTP_USER=contact@tybianacademy.com
#   SMTP_FROM="تبيان | TIBYAN" <contact@tybianacademy.com>
#
# Only set MAIL_REPLY_TO when the sending mailbox and the one you want
# answered genuinely differ.
SMTP_FROM=
MAIL_REPLY_TO=
